{
  "manifest_version": 2,

  "name": "Truth Toggle",
  "description": "This extension redirects Wikipedia to Grokipedia (with Infogalactic fallback) and allows toggling between sources.",
  "icons": {
           "48": "./images/IW-48.png",
          "128": "./images/IW-128.png" },
  "version": "1.3",
  "background": {
    "scripts": ["background.js"]
  },

  "browser_action": {
    "default_title": "Get me outta here!"
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "<all_urls>",
    "webRequest",
    "webRequestBlocking"
  ]
}
