{
  "manifest_version": 3,

  "name": "Truth Toggle",
  "description": "Redirects Wikipedia to Grokipedia with Infogalactic fallback. Toggle between sources. By Melon Bark, LLC.",
  "homepage_url": "https://MelonBark.com",
  "author": "Melon Bark, LLC",
  "icons": { "16": "images/truth-toggle-16.png",
           "48": "images/truth-toggle-48.png",
          "128": "images/truth-toggle-128.png" },
  "version": "1.6",
  "background": {
    "service_worker": "service_worker.js"
  },

  "action": {
    "default_title": "Truth Toggle"
  },
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "*://*.wikipedia.org/*",
    "*://*.grokipedia.com/*",
    "*://*.infogalactic.com/*"
  ]
}